# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The public URL where this applet is hosted (e.g. Cloud Run or Vercel URL).
# Used for Safepay redirect callbacks, cancel links, and self-referencing APIs.
APP_URL=

# SAFEPAY_ENV: 'sandbox' for testing, 'production' for live payments
SAFEPAY_ENV=sandbox

# SAFEPAY_PUBLIC_KEY: Safepay Merchant Public Key (pub_... or pub_sandbox_...)
SAFEPAY_PUBLIC_KEY=

# SAFEPAY_SECRET_KEY: Safepay Merchant Secret Key (sec_... or sec_sandbox_...)
# NEVER expose this key to client-side code!
SAFEPAY_SECRET_KEY=

# SAFEPAY_WEBHOOK_SECRET: Shared secret from Safepay Merchant Dashboard for webhook HMAC-SHA256 verification
SAFEPAY_WEBHOOK_SECRET=

# SAFEPAY_BASE_URL: Optional API URL override (defaults to https://sandbox.api.getsafepay.com or https://api.getsafepay.com)
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com

# SAFEPAY_PRO_MONTHLY_PLAN_ID: Safepay Subscription Plan ID for Developer Pro Monthly ($7.99/mo)
SAFEPAY_PRO_MONTHLY_PLAN_ID=

# SAFEPAY_PRO_ANNUAL_PLAN_ID: Safepay Subscription Plan ID for Developer Pro Annual ($59/yr)
SAFEPAY_PRO_ANNUAL_PLAN_ID=

# SAFEPAY_TEAM_PLAN_ID: Safepay Subscription Plan ID for Team Workspace ($29/mo)
SAFEPAY_TEAM_PLAN_ID=

# GOOGLE ADSENSE CONFIGURATION
# VITE_ADSENSE_CLIENT_ID: Your Google AdSense Publisher Client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
# Free users will see non-intrusive developer ads; Pro/Team subscribers have ads 100% disabled.
VITE_ADSENSE_CLIENT_ID=

# GEMINI AI MODEL & ABUSE PROTECTION CONFIGURATION
# GEMINI_MODEL: Gemini Model alias (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# AI_MAX_REQUEST_LENGTH: Maximum prompt character length allowed (default 60000)
AI_MAX_REQUEST_LENGTH=60000

# AI_MAX_OUTPUT_TOKENS: Maximum token generation limit per AI request (default 4096)
AI_MAX_OUTPUT_TOKENS=4096
