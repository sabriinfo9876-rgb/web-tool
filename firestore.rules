rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Documents (plan status, quota tracking, subscription info)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Usage Tracking Subcollection (users/{userId}/usage/{date})
      match /usage/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subscription History Subcollection
      match /subscriptions/{subId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only updated via server / admin SDK
      }
    }

    // Cloud Snippets Vault Collection (User-owned code store with strict size bounds)
    match /snippets/{snippetId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['title', 'code'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.code is string
                    && request.resource.data.code.size() <= 100000;
                    
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
